{
    "name": "vibe-workspace",
    "displayName": "Vibe Coding Workspace",
    "publisher": "local-vibe",
    "version": "2.6.5",
    "engines": {
        "vscode": "^1.94.0"
    },
    "main": "./extension.js",
    "activationEvents": [
        "*",
        "onStartupFinished"
    ],
    "contributes": {
        "commands": [
            {
                "command": "vibe.restoreLayout",
                "title": "Vibe Coding: Restore Preview | Code | Codex"
            },
            {
                "command": "vibe.toggleTerminal",
                "title": "Vibe Coding: Toggle Terminal (Full / 3-Columns)",
                "icon": "$(screen-full)"
            },
            {
                "command": "vibe.togglePreview",
                "title": "Vibe Coding: Toggle Preview (Full / 3-Columns)",
                "icon": "$(browser)"
            },
            {
                "command": "vibe.restoreCheckpoint",
                "title": "Vibe Coding: Time Machine (되돌리기 타임머신)",
                "icon": "$(history)"
            },
            {
                "command": "vibe.createCheckpoint",
                "title": "Vibe Coding: Save Checkpoint (현재 시점 스냅샷 저장)",
                "icon": "$(save)"
            },
            {
                "command": "vibe.openExternalBrowser",
                "title": "Vibe Coding: Open in External Browser (Chrome/Edge)",
                "icon": "$(link-external)"
            },
            {
                "command": "vibe.pasteImage",
                "title": "Vibe Coding: Paste Clipboard Image (Alt+V)",
                "icon": "$(file-media)"
            },
            {
                "command": "vibe.openMobileRemote",
                "title": "Vibe Coding: Mobile Remote Setup",
                "icon": "$(device-mobile)"
            }
        ],
        "menus": {
            "editor/title": [
                {
                    "command": "vibe.toggleTerminal",
                    "group": "navigation",
                    "when": "config.vibe.enabled"
                },
                {
                    "command": "vibe.togglePreview",
                    "group": "navigation",
                    "when": "config.vibe.enabled"
                },
                {
                    "command": "vibe.restoreCheckpoint",
                    "group": "navigation",
                    "when": "config.vibe.enabled"
                },
                {
                    "command": "vibe.openExternalBrowser",
                    "group": "navigation",
                    "when": "config.vibe.enabled"
                },
                {
                    "command": "vibe.pasteImage",
                    "group": "navigation",
                    "when": "config.vibe.enabled"
                },
                {
                    "command": "vibe.openMobileRemote",
                    "group": "navigation",
                    "when": "config.vibe.enabled"
                }
            ]
        },
        "keybindings": [
            {
                "command": "vibe.restoreCheckpoint",
                "key": "alt+z",
                "mac": "alt+z",
                "when": "config.vibe.enabled"
            },
            {
                "command": "vibe.pasteImage",
                "key": "alt+v",
                "mac": "alt+v",
                "when": "config.vibe.enabled"
            }
        ],
        "configuration": {
            "title": "Vibe Coding",
            "properties": {
                "vibe.enabled": {
                    "type": "boolean",
                    "default": true
                },
                "vibe.codexPath": {
                    "type": "string",
                    "default": ""
                },
                "vibe.entryFile": {
                    "default": "index.html",
                    "type": "string"
                },
                "vibe.previewUrl": {
                    "default": "",
                    "type": "string"
                }
            }
        }
    }
}
