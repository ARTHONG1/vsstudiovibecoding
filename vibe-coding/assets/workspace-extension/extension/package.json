{
    "name":  "vibe-workspace",
    "displayName":  "Vibe Coding Workspace",
    "publisher":  "local-vibe",
    "version":  "2.1.2",
    "engines":  {
                    "vscode":  "^1.94.0"
                },
    "main":  "./extension.js",
    "activationEvents":  [
                             "*"
                         ],
    "contributes":  {
                        "commands":  [
                                        {
                                            "command":  "vibe.restoreLayout",
                                            "title":  "Vibe Coding: Restore Preview | Code | Codex"
                                        },
                                        {
                                            "command":  "vibe.toggleTerminal",
                                            "title":  "Vibe Coding: Toggle Terminal (Full / 3-Columns)",
                                            "icon":  "$(screen-full)"
                                        },
                                        {
                                            "command":  "vibe.togglePreview",
                                            "title":  "Vibe Coding: Toggle Preview (Full / 3-Columns)",
                                            "icon":  "$(browser)"
                                        },
                                        {
                                            "command":  "vibe.openExternalBrowser",
                                            "title":  "Vibe Coding: Open in External Browser (Chrome/Edge)",
                                            "icon":  "$(link-external)"
                                        },
                                        {
                                            "command":  "vibe.pasteImage",
                                            "title":  "Vibe Coding: Paste Clipboard Image (Alt+V)",
                                            "icon":  "$(file-media)"
                                        }
                                    ],
                        "menus":  {
                                      "editor/title":  [
                                                           {
                                                               "command":  "vibe.toggleTerminal",
                                                               "group":  "navigation",
                                                               "when":  "config.vibe.enabled"
                                                           },
                                                           {
                                                               "command":  "vibe.togglePreview",
                                                               "group":  "navigation",
                                                               "when":  "config.vibe.enabled"
                                                           },
                                                           {
                                                               "command":  "vibe.openExternalBrowser",
                                                               "group":  "navigation",
                                                               "when":  "config.vibe.enabled"
                                                           },
                                                           {
                                                               "command":  "vibe.pasteImage",
                                                               "group":  "navigation",
                                                               "when":  "config.vibe.enabled"
                                                           }
                                                       ]
                                  },
                        "keybindings": [
                                           {
                                               "command": "vibe.pasteImage",
                                               "key": "alt+v",
                                               "mac": "alt+v",
                                               "when": "config.vibe.enabled"
                                           }
                                       ],
                        "configuration":  {
                                              "title":  "Vibe Coding",
                                              "properties":  {
                                                                 "vibe.enabled":  {
                                                                                      "type":  "boolean",
                                                                                      "default":  false
                                                                                  },
                                                                "vibe.codexPath":  {
                                                                                          "type":  "string",
                                                                                          "default":  ""
                                                                                      },
                                                                 "vibe.opencodePath":  {
                                                                                           "type":  "string",
                                                                                           "default":  ""
                                                                                       },
                                                                 "vibe.entryFile":  {
                                                                                        "default":  "index.html",
                                                                                        "type":  "string"
                                                                                    },
                                                                 "vibe.previewUrl":  {
                                                                                         "default":  "",
                                                                                         "type":  "string"
                                                                                     }
                                                             }
                                          }
                    }
}
